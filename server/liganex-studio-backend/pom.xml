<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!-- 继承 liganex-server 聚合父 POM（其 parent 为 spring-boot-starter-parent 4.1.0，见 ADR-0001） -->
  <parent>
    <groupId>com.liganex</groupId>
    <artifactId>liganex-server</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <relativePath>../pom.xml</relativePath>
  </parent>

  <groupId>tech.liganex</groupId>
  <artifactId>liganex-studio-backend</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <name>liganex-studio-backend</name>
  <description>Liganex Studio backend — auth, order domain, open platform (modular monolith, ADR-0006)</description>

  <properties>
    <!-- java.version / maven.compiler.release 继承自父 pom（liganex-server），当前为 Java 21 LTS -->
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <mybatis-plus.version>3.5.16</mybatis-plus.version>
    <langchain4j.version>1.19.0</langchain4j.version>
    <pdfbox.version>3.0.6</pdfbox.version>
    <!--
      Spring Cloud 兼容版本线（为将来转微服务预留，见 ADR-0006 / ADR-0009）。
      兼容矩阵（Spring Cloud 官方）：
        Spring Cloud 2025.1.x（代号 Oakwood） → Spring Boot 4.0.x、4.1.x（自 2025.1.2 起支持 4.1.0）
      当前 Spring Boot 父 POM 为 4.1.0，故锁定 2025.1.3（Oakwood 训练最新稳定服务版）。
      本仓库当前为「模块化单体」，不引入网关/注册中心（ADR-0006）。
      后续若要转微服务，可在下方 managed 版本下直接添加以下 starter，无需再对版本号：
        - spring-cloud-starter-gateway            （API 网关）
        - spring-cloud-starter-netflix-eureka-client / spring-cloud-starter-consul-discovery（注册发现）
        - spring-cloud-starter-config             （配置中心）
        - spring-cloud-starter-openfeign          （声明式服务间调用，配合 ADR-0009 的 OrderQueryClient）
        - spring-cloud-starter-circuitbreaker-resilience4j（熔断降级）
    -->
    <spring-cloud.version>2025.1.3</spring-cloud.version>
  </properties>

  <!--
    Spring Cloud BOM：仅做依赖版本管理（BOM-only），不含任何插件或 Spring/Boot 直接引用。
    与 spring-boot-starter-parent 的 dependencyManagement 叠加，确保未来引入的
    Spring Cloud 组件版本与 Boot 4.1.0 兼容、彼此间无冲突。
  -->
  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.springframework.cloud</groupId>
        <artifactId>spring-cloud-dependencies</artifactId>
        <version>${spring-cloud.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <!-- Web -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>
    <!--
      Spring Boot 4 起 RestClient 自动配置独立成 starter（与上面的 Flyway 同理）：
      仅靠 spring-boot-starter-web 不会有 RestClient.Builder bean，视频生成模块的
      OpenAI 适配器构造器注入会因缺少依赖而启动失败。测试里自建 RestClient.builder()
      不会暴露该问题，故必须在此显式引入。
    -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-restclient</artifactId>
    </dependency>

    <!-- Security + JWT (OAuth2 Resource Server 提供 Nimbus JWT 编解码) -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-security</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-oauth2-resource-server</artifactId>
    </dependency>

    <!-- Persistence: Flyway 管 DDL，MyBatis-Plus 管 DML（ADR-0005） -->
    <!-- spring-boot-starter-jdbc 提供 DataSource 自动配置（HikariCP）；
         MyBatis-Plus starter 不传递该依赖，缺失时不会有 DataSource，Flyway 也不会执行 -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-jdbc</artifactId>
    </dependency>
    <dependency>
      <groupId>com.baomidou</groupId>
      <artifactId>mybatis-plus-spring-boot4-starter</artifactId>
      <version>${mybatis-plus.version}</version>
    </dependency>
    <!-- 分页插件 PaginationInnerInterceptor 自 3.5.9 起位于本模块 -->
    <dependency>
      <groupId>com.baomidou</groupId>
      <artifactId>mybatis-plus-jsqlparser</artifactId>
      <version>${mybatis-plus.version}</version>
    </dependency>
    <!-- Spring Boot 4 起 Flyway 自动配置独立成 starter，仅加 flyway-core 不会触发迁移 -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-flyway</artifactId>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-database-postgresql</artifactId>
    </dependency>
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <scope>runtime</scope>
    </dependency>

    <!-- Redis: 应用校验缓存、nonce 防重放、配额 -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-redis</artifactId>
    </dependency>

    <!-- RAG: 仅复用统一模型 API；pgvector 表与混合检索 SQL 由本项目管理 -->
    <dependency>
      <groupId>dev.langchain4j</groupId>
      <artifactId>langchain4j-core</artifactId>
      <version>${langchain4j.version}</version>
    </dependency>
    <dependency>
      <groupId>dev.langchain4j</groupId>
      <artifactId>langchain4j-open-ai</artifactId>
      <version>${langchain4j.version}</version>
    </dependency>
    <dependency>
      <groupId>org.apache.pdfbox</groupId>
      <artifactId>pdfbox</artifactId>
      <version>${pdfbox.version}</version>
    </dependency>

    <!-- Observability -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>

    <dependency>
      <groupId>org.projectlombok</groupId>
      <artifactId>lombok</artifactId>
      <optional>true</optional>
    </dependency>

    <!-- Test -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- Spring Boot 4 把 Web 测试切片拆成独立 starter：@WebMvcTest/MockMvc 需显式引入 -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-webmvc-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.security</groupId>
      <artifactId>spring-security-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <configuration>
          <!-- JDK 25 下需显式声明注解处理器路径，否则 Lombok 不生成 getter/setter -->
          <annotationProcessorPaths>
            <path>
              <groupId>org.projectlombok</groupId>
              <artifactId>lombok</artifactId>
              <version>${lombok.version}</version>
            </path>
          </annotationProcessorPaths>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <configuration>
          <excludes>
            <exclude>
              <groupId>org.projectlombok</groupId>
              <artifactId>lombok</artifactId>
            </exclude>
          </excludes>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
